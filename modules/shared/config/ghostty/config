theme = Catppuccin Frappe
# ガラス風の透過: macOS 26のネイティブglass + 少し強めの透過
background-opacity = 0.62
background-blur = macos-glass-regular
# nvim/tmuxなど背景色を塗るアプリでも透過させる
background-opacity-cells = true
# 余白でガラス面を見せる
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
# 非フォーカスsplitは軽く曇らせる程度に
unfocused-split-opacity = 0.85

font-family = Comic Mono
macos-option-as-alt = true
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
# 内部ウィンドウタイトルのスピナー更新でAppKitのtitle更新が走るのを止める
title = Ghostty
shell-integration-features = cursor,no-sudo,no-title,no-ssh-env,no-ssh-terminfo,path

# クイックターミナルの位置を画面上部に設定
quick-terminal-position = "top"

# クイックターミナルを表示するスクリーンを設定 (メインスクリーン)
quick-terminal-screen = "main"

# アニメーション時間を0.2秒に設定 (お好みで調整可能)
quick-terminal-animation-duration = 0

# フォーカスを失った時に自動的に隠す
# quick-terminal-auto-hide = true

# グローバルホットキーを設定 (例: Ctrl+Command+`)
keybind = "global:ctrl+cmd+`=toggle_quick_terminal"

# ctrl+;を無視。SKKとのコンフリクトを解消
keybind = ctrl+;=ignore
