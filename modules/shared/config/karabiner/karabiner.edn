{
  :applications {
    :parallels ["^com\\.parallels\\.desktop\\.console$"]
  }
  :simlayers {
    :space-layer {:key :spacebar}
  }
  :main [{
    :des "Space layer"
    :rules [:space-layer
      [:q :1]
      [:w :2]
      [:e :3]
      [:r :4]
      [:t :5]
      [:y :6]
      [:u :7]
      [:i :8]
      [:o :9]
      [:p :0]
      [:a :!S1]    ;; !
      [:s :!S2]    ;; @
      [:d :!S3]    ;; #
      [:f :!S4]    ;; $
      [:g :!S5]    ;; %
      [:h :!S6]    ;; ^
      [:j :!S7]    ;; &
      [:k :!S8]    ;; *
      [:l :!S9]    ;; (
      [:z :!Sbackslash]     ;; |
      [:x :slash]           ;; /
      [:c :!Speriod]        ;; >
      [:v :!Scomma]         ;; <
      [:b :hyphen]          ;; -
      [:n :!Shyphen]        ;; _
      [:m :equal_sign]      ;; =
      [:comma :!Sequal_sign] ;; +
      [:period :!Sopen_bracket] ;; {
      [:slash :!Sclose_bracket] ;; }
    ]
  },
  {
    :des "built-in keyboard change"
    :rules [
      [:##caps_lock :left_control]
      [:##backslash :backslash]  ;; バックスラッシュを元の機能に戻す
      [:##delete_or_backspace :delete_or_backspace]  ;; バックスペースを元の機能に戻す
      [:##grave_accent_and_tilde :grave_accent_and_tilde]  ;; チルダキーを元の機能に戻す
      ;; disable unnecessary keys
      [:##f1 :vk_none]
      [:##f2 :vk_none]
      [:##f3 :vk_none]
      [:##f4 :vk_none]
      [:##f5 :vk_none]
      [:##f6 :vk_none]
      [:##f7 :vk_none]
      [:##f8 :vk_none]
      [:##f9 :vk_none]
      [:##f10 :vk_none]
      [:##f11 :vk_none]
      [:##f12 :vk_none]
    ]
  },
  {
    :des "Semicolon to Control on hold, Semicolon on tap"
    :rules [
      [:##semicolon :left_control nil {:alone :semicolon}]
    ]
  },
  {
    :des "Right Option + workspace keys moves focused AeroSpace window"
    :rules [
      [:!Eq :!OSq]
      [:!Ew :!OSw]
      [:!Ee :!OSe]
      [:!Er :!OSr]
      [:!Et :!OSt]
      [:!Ea :!OSa]
      [:!Es :!OSs]
      [:!Ed :!OSd]
      [:!Ef :!OSf]
      [:!Eg :!OSg]
      [:!Ez :!OSz]
      [:!Ex :!OSx]
      [:!Ec :!OSc]
      [:!Ev :!OSv]
      [:!Eb :!OSb]
    ]
  },
  {
    :des "Right Command to Shiftless Hyper (Ctrl+Option+Command)"
    :rules [
      [:##right_command {:key :left_option :modi [:left_command :left_control]} :!parallels]
    ]
  },
  {
    :des "OmniWM: Left Option + H/L focuses left/right column"
    :rules [
      [:!Oh "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command focus left" :!parallels]
      [:!Ol "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command focus right" :!parallels]
    ]
  },
  {
    :des "OmniWM: Right Command (Hyper) + Shift + qwertasdfgzxcvb moves window to workspace 1-15"
    :rules [
      [{:key :q :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 1" :!parallels]
      [{:key :w :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 2" :!parallels]
      [{:key :e :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 3" :!parallels]
      [{:key :r :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 4" :!parallels]
      [{:key :t :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 5" :!parallels]
      [{:key :a :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 6" :!parallels]
      [{:key :s :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 7" :!parallels]
      [{:key :d :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 8" :!parallels]
      [{:key :f :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 9" :!parallels]
      [{:key :g :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 10" :!parallels]
      [{:key :z :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 11" :!parallels]
      [{:key :x :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 12" :!parallels]
      [{:key :c :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 13" :!parallels]
      [{:key :v :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 14" :!parallels]
      [{:key :b :modi {:mandatory [:left_command :left_control :left_option :shift]}} "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 15" :!parallels]
    ]
  },
  {
    :des "OmniWM: Right Command (Hyper) + M toggles workspace bar (reveals macOS menu bar)"
    :rules [
      [:!CTOm "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command toggle-workspace-bar" :!parallels]
    ]
  },
  {
    :des "OmniWM: Right Command (Hyper) + qwertasdfgzxcvb switches workspace 1-15"
    :rules [
      [:!CTOq "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 1" :!parallels]
      [:!CTOw "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 2" :!parallels]
      [:!CTOe "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 3" :!parallels]
      [:!CTOr "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 4" :!parallels]
      [:!CTOt "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 5" :!parallels]
      [:!CTOa "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 6" :!parallels]
      [:!CTOs "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 7" :!parallels]
      [:!CTOd "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 8" :!parallels]
      [:!CTOf "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 9" :!parallels]
      [:!CTOg "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 10" :!parallels]
      [:!CTOz "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 11" :!parallels]
      [:!CTOx "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 12" :!parallels]
      [:!CTOc "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 13" :!parallels]
      [:!CTOv "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 14" :!parallels]
      [:!CTOb "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command switch-workspace 15" :!parallels]
    ]
  }]
}
