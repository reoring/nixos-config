+// HERDR: an IME can use Control keys to enter composition (AquaSKK, macSKK).
+// Keep Command/Function shortcuts out of AppKit's text handling.
+fn is_ime_keystroke(keystroke: &Keystroke) -> bool {
+    !keystroke.modifiers.platform
+        && !keystroke.modifiers.function
+        && (keystroke.modifiers.control
+            || keystroke
+                .key_char
+                .as_ref()
+                .is_some_and(|text| text.chars().all(|c| !c.is_control())))
+}
